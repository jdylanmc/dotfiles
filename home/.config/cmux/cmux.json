{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // cmux writes its full commented default set into this file on first run.
  // Only authored settings are tracked here; read the schema above for the
  // full surface.

  "app": {
    // The Ghostty theme only colours terminal surfaces. The sidebar, tab bar,
    // and title bar are native AppKit and follow the system appearance, so a
    // dark terminal sits inside a light window until this is set.
    "appearance": "dark",

    // Fallback editor for anything cmux cannot preview, and the target of the
    // file explorer's double-click action below.
    "preferredEditor": "code",

    // Keep the workspace list stable. By default a workspace with a new
    // notification is moved toward the top, reordering the sidebar while you
    // are reading it.
    "reorderOnNotification": false,

    // Cmd-click previews files in cmux, with markdown rendered live rather
    // than shown as source.
    "openSupportedFilesInCmux": true,
    "openMarkdownInCmuxViewer": true
  },

  // Take the terminal's background rather than a neutral grey.
  "sidebarAppearance": {
    "matchTerminalBackground": true
  },

  // Double-clicking a file in the explorer opens it in `preferredEditor`
  // instead of cmux's built-in preview.
  "fileExplorer": {
    "doubleClickAction": "preferredEditor"
  }
}
